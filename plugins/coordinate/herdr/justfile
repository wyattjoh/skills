default:
    @just --list

# Run the View tests against herdr-dev's renderer and local host-service extensions
test:
    bun run test

# Type-check against Herdr's installed declarations (copied into a local cache, never written back)
typecheck:
    bun run typecheck

# Check source timer intervals with the shared herdr-dev lint
render-sync:
    bunx herdr-render-sync src/mods

# Bundle every mod into .scratch/stage-* and validate with herdr-dev; never installs
build:
    bun run build

# Explicit, approved live write: build and check a stage, then copy every bundled mod into
# HERDR_APP_HOME/mods (default ~/.config/herdr-app) and merge any keys.json bindings. --replace
# backs up matching installed mods (under .scratch/) and replaces them
[positional-arguments]
install *args:
    bun scripts/install.ts "$@"

# Tests, typecheck, render-sync and staged build. Never installs; deploying is just install, after approval
check: test typecheck render-sync build
