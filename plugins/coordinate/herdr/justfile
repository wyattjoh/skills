default:
    @just --list

# Run the View and model tests against the gpui-kit, gpui-base and herdr doubles
test:
    bun run test

# Type-check against Herdr's installed declarations (copied into a local cache, never written back)
typecheck:
    bun run typecheck

# Bundle every mod into .scratch/stage-* and run herdr-app check with that stage as HERDR_APP_HOME; never installs
build:
    bun run build

# Explicit, approved live write: build and check a stage, then copy every mod into
# HERDR_APP_HOME/mods (default ~/.config/herdr-app) and add keys.json's cmd-alt-b binding to the
# person's keys.json. --replace backs up mods already installed (under .scratch/) and replaces them
[positional-arguments]
install *args:
    bun scripts/install.ts "$@"

# Tests, typecheck and the staged build. Never installs: deploying is just install, after approval
check: test typecheck build
