{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coordinate-implementation/agreements.v1.schema.json",
  "title": "coordinate-implementation cross-run agreements file, schema version 1",
  "type": "object",
  "required": [
    "kind",
    "schema_version",
    "common_dir",
    "owner_run_id",
    "merge_order",
    "shared_files",
    "updated_at"
  ],
  "properties": {
    "kind": { "type": "string", "const": "agreements" },
    "schema_version": { "type": "number", "const": 1 },
    "common_dir": { "type": "string" },
    "owner_run_id": { "type": "string", "format": "uuid" },
    "merge_order": { "type": "array", "items": { "type": "string" } },
    "shared_files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "owner_prefix"],
        "properties": {
          "path": { "type": "string" },
          "owner_prefix": { "type": "string" }
        }
      }
    },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
