{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],
  timezone: "__TIMEZONE__",
  dependencyDashboard: true,
  automerge: false,
  prConcurrentLimit: 3,
  prHourlyLimit: 2,
  // Keep whole-lock refreshes separate from individually reviewed updates.
  lockFileMaintenance: {
    enabled: false,
  },
}
