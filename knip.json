{
  "$schema": "./node_modules/knip/schema.json",
  "ignore": [
    ".scratch/**",
    ".claude/references/**",
    ".remember/**",
    "skills/effect-ts/.source/**",
    "skills/dialkit/references/DialKitPersistence.tsx",
    "plugins/*/tests/**"
  ],
  "ignoreBinaries": ["du", "pgrep"],
  "workspaces": {
    ".": {},
    "skills/*": {
      "entry": ["scripts/*.ts"],
      "project": ["scripts/**/*.ts"]
    },
    "skills/claude-sessions": {
      "entry": ["scripts/*.ts", "references/types.ts"],
      "project": ["scripts/**/*.ts"]
    },
    "plugins/*": {
      "entry": ["pi/index.ts", "hooks/core/*.spec.ts", "pi/*.spec.ts"],
      "project": ["hooks/core/**/*.ts", "pi/**/*.ts"]
    }
  },
  "ignoreExportsUsedInFile": true
}
